#!/usr/bin/env bash
# CloverArcade -- launch native MAME inside the KasmVNC session.
# Keeps restarting MAME so exiting a game returns you to the cabinet menu.
set -u

ROM_PATH="${MAME_ROM_PATH:-/roms/arcade}"
CFG_DIR="/config/.mame"
GAME="${MAME_GAME:-}"
EXTRA="${MAME_EXTRA_ARGS:-}"

mkdir -p "$CFG_DIR/cfg" "$CFG_DIR/nvram" "$CFG_DIR/sta" "$CFG_DIR/snap" \
         "$CFG_DIR/diff" "$CFG_DIR/comments" "$CFG_DIR/hi"

INI="$CFG_DIR/mame.ini"
if [ ! -f "$INI" ]; then
  cat > "$INI" <<EOF
# Generated by CloverArcade on first run -- edit freely, it is not overwritten.
rompath              $ROM_PATH
cfg_directory        $CFG_DIR/cfg
nvram_directory      $CFG_DIR/nvram
state_directory      $CFG_DIR/sta
snapshot_directory   $CFG_DIR/snap
diff_directory       $CFG_DIR/diff
comment_directory    $CFG_DIR/comments
video                opengl
window               0
maximize             1
keepaspect           1
unevenstretch        0
filter               1
sound                sdl
samplerate           48000
skip_gameinfo        1
EOF
  echo "[OK] wrote default MAME config to $INI"
fi

if [ ! -d "$ROM_PATH" ]; then
  echo "[WARN] ROM path $ROM_PATH does not exist -- mount ./roms/arcade into the container"
fi

echo "[OK] CloverArcade cabinet starting -- rompath=$ROM_PATH game=${GAME:-<menu>}"

while true; do
  # shellcheck disable=SC2086
  mame -inipath "$CFG_DIR" -rompath "$ROM_PATH" $EXTRA $GAME
  code=$?
  echo "-- MAME exited with code $code, returning to cabinet menu in 2s"
  sleep 2
done
